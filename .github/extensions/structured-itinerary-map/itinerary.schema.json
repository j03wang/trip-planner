{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trip-planner:itinerary:1.0",
  "title": "Structured itinerary map document",
  "description": "Version 1.0 contract for a portable itinerary that separates schedule entries from reusable mapped places.",
  "type": "object",
  "required": ["schemaVersion", "trip", "locations", "places", "days"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "trip": {
      "$ref": "#/$defs/trip"
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/location"
      }
    },
    "places": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/place"
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/day"
      }
    },
    "transportLegs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transportLeg"
      }
    },
    "recommendedStayAreas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stayArea"
      }
    },
    "categoryStyles": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/category"
      },
      "additionalProperties": {
        "$ref": "#/$defs/categoryStyle"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "localDateTime": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "timeZone": {
      "type": "string",
      "pattern": "^[A-Za-z_]+(?:/[A-Za-z0-9_+.-]+)+$",
      "maxLength": 80
    },
    "status": {
      "type": "string",
      "enum": ["tentative", "planned", "booked", "optional", "cancelled"]
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "coordinate": {
      "type": "object",
      "required": ["latitude", "longitude"],
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "trip": {
      "type": "object",
      "required": ["id", "title", "startDate", "endDate"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "startDate": {
          "$ref": "#/$defs/date"
        },
        "endDate": {
          "$ref": "#/$defs/date"
        },
        "summary": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "location": {
      "type": "object",
      "required": ["id", "name", "timezone", "coordinates"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "country": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "timezone": {
          "$ref": "#/$defs/timeZone"
        },
        "coordinates": {
          "$ref": "#/$defs/coordinate"
        },
        "zoom": {
          "type": "number",
          "minimum": 0,
          "maximum": 22
        }
      }
    },
    "place": {
      "type": "object",
      "required": ["id", "name", "locationId", "coordinates"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "locationId": {
          "$ref": "#/$defs/identifier"
        },
        "coordinates": {
          "$ref": "#/$defs/coordinate"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "address": {
          "type": "string",
          "maxLength": 500
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "url": {
          "type": "string",
          "pattern": "^https?://",
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "activity": {
      "type": "object",
      "required": ["id", "name", "kind", "category"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "kind": {
          "type": "string",
          "enum": ["visit", "activity", "meal", "lodging", "rest", "free-time", "reminder", "check-in", "other"]
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "placeId": {
          "$ref": "#/$defs/identifier"
        },
        "locationId": {
          "$ref": "#/$defs/identifier"
        },
        "energy": {
          "type": "string",
          "enum": ["low", "moderate", "high", "recovery", "transit"]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "startTime": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "endTime": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        },
        "url": {
          "type": "string",
          "pattern": "^https?://",
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "day": {
      "type": "object",
      "required": ["id", "date", "title", "locationIds", "activities"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "locationIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "summary": {
          "type": "string",
          "maxLength": 2000
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        },
        "tip": {
          "type": "string",
          "maxLength": 1000
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activity"
          }
        }
      }
    },
    "transportLeg": {
      "type": "object",
      "required": ["id", "mode", "originPlaceId", "destinationPlaceId"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "dayId": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "mode": {
          "type": "string",
          "enum": ["walk", "bike", "drive", "bus", "rail", "ferry", "flight", "other"]
        },
        "originPlaceId": {
          "$ref": "#/$defs/identifier"
        },
        "destinationPlaceId": {
          "$ref": "#/$defs/identifier"
        },
        "departureLocalDateTime": {
          "$ref": "#/$defs/localDateTime"
        },
        "arrivalLocalDateTime": {
          "$ref": "#/$defs/localDateTime"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "carrier": {
          "type": "string",
          "maxLength": 120
        },
        "serviceNumber": {
          "type": "string",
          "maxLength": 80
        },
        "bookingNotes": {
          "type": "string",
          "maxLength": 2000
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "description": "Optional GeoJSON-like multi-line geometry. Split a line at the antimeridian so adjacent longitudes never differ by more than 180 degrees.",
          "items": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/$defs/coordinate"
            }
          }
        }
      }
    },
    "stayArea": {
      "type": "object",
      "required": ["id", "locationId", "name", "boundaries"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "locationId": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "boundaries": {
          "type": "array",
          "minItems": 1,
          "description": "Polygon rings. Each ring must contain at least four coordinates and repeat its first coordinate as its last.",
          "items": {
            "type": "array",
            "minItems": 4,
            "items": {
              "$ref": "#/$defs/coordinate"
            }
          }
        }
      }
    },
    "categoryStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    }
  }
}
